DATABASE_URL="postgresql://ecom:ecom@localhost:5433/ecom?schema=public"
PORT=4000
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me
COOKIE_SECRET=change-me
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Razorpay — Dashboard → Account & Settings → API Keys (use TEST mode keys: rzp_test_…)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks → the secret you set when creating the webhook
RAZORPAY_WEBHOOK_SECRET=

# BullMQ (Redis from docker-compose, host port 6380)
REDIS_URL=redis://localhost:6380
# true = workers run inside the API process (dev). In production set false and run `pnpm --filter @ecom/api worker`
RUN_WORKERS_IN_API=true
# Unpaid orders are auto-cancelled (stock released) after this many minutes
ORDER_PAYMENT_TIMEOUT_MINUTES=30
